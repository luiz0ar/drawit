# Backend / API
APP_PORT=8080
APP_ENV=development
RUST_LOG=info,drawit_api=debug

# MongoDB
MONGO_URL=mongodb://mongo:27017/drawit
MONGO_DB_NAME=drawit

# Auth & JWT
JWT_SECRET=super_secret_drawit_jwt_development_key_minimum_32_chars!
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
LOGIN_DELAY_MS=1000

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:3000,http://10.1.91.189:3000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080

# RabbitMQ / Message Broker
AMQP_URL=amqp://guest:guest@rabbitmq:5672

# Mailer & SMTP (Mailhog em dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=DrawIt <no-reply@drawit.local>
APP_PUBLIC_URL=http://localhost:3000

# Verification & Rate Limit
VERIFY_LINK_TTL_HOURS=24
VERIFY_RESEND_COOLDOWN_SECONDS=90

