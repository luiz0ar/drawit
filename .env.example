# -----------------------------------------------------------------------------
# Configurações do drawit (Ambiente de Desenvolvimento)
# -----------------------------------------------------------------------------

# Backend / API
APP_PORT=8080
APP_ENV=development
RUST_LOG=info,drawit_api=debug

# MongoDB
MONGO_URL=mongodb://mongo:27017/drawit
MONGO_DB_NAME=drawit

# Autenticação & JWT
# Chave secreta de pelo menos 32 caracteres para HS256 em ambiente de desenvolvimento
JWT_SECRET=super_secret_drawit_jwt_development_key_minimum_32_chars!
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000

